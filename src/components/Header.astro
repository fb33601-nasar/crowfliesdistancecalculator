---
import Logo from './Logo.astro';
import { SITE } from '../lib/site';
import { liveTools } from '../data/tools';
const tools = liveTools();
const here = Astro.url.pathname;
---
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label={`${SITE.name} home`}>
      <Logo />
      <span>{SITE.shortName}<small>Distance calculator</small></span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        <li class="menu">
          <details>
            <summary>Tools</summary>
            <ul class="menu-list">
              {tools.map((t) => (
                <li>
                  <a href={t.href} aria-current={here === t.href ? 'page' : undefined}>
                    <strong>{t.name}</strong>
                    <span>{t.blurb}</span>
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </li>
        <li><a href="/about/" aria-current={here === '/about/' ? 'page' : undefined}>About</a></li>
        <li><a href="/contact/" aria-current={here === '/contact/' ? 'page' : undefined}>Contact</a></li>
      </ul>
    </nav>
  </div>
</header>
<script>
  // Close the Tools menu on outside click or Escape.
  const menu = document.querySelector<HTMLDetailsElement>('.site-nav details');
  if (menu) {
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>
