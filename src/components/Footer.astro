---
import Logo from './Logo.astro';
import { SITE } from '../lib/site';
import { liveTools } from '../data/tools';
const year = new Date().getFullYear();
const tools = liveTools();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div>
        <a class="brand" href="/"><Logo /><span>{SITE.shortName}</span></a>
        <p style="margin-top:.9rem;max-width:34ch">Free calculators for straight line and travel distance between any two places, measured on the WGS 84 model of the Earth.</p>
      </div>
      <div>
        <h2>Tools</h2>
        <ul>
          {tools.map((t) => <li><a href={t.href}>{t.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Guides</h2>
        <ul>
          <li><a href="/as-the-crow-flies-meaning/">As the crow flies meaning</a></li>
          <li><a href="/google-maps-as-the-crow-flies/">Google Maps as the crow flies</a></li>
        </ul>
        <h2 class="footer-sub">Site</h2>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacy-policy/">Privacy policy</a></li>
          <li><a href="/terms/">Terms of use</a></li>
        </ul>
      </div>
      <div>
        <h2>Map and place data</h2>
        <ul>
          <li>Map data © <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap</a> contributors</li>
          <li>Tiles by <a href="https://openfreemap.org/" rel="noopener">OpenFreeMap</a>, search by <a href="https://photon.komoot.io/" rel="noopener">Photon</a></li>
          <li>Routes by <a href="https://routing.openstreetmap.de/" rel="noopener">FOSSGIS OSRM</a></li>
          <li>Cities from <a href="https://www.geonames.org/" rel="noopener">GeoNames</a>, borders from <a href="https://www.naturalearthdata.com/" rel="noopener">Natural Earth</a></li>
          <li><a href="https://www.openstreetmap.org/fixthemap" rel="noopener">Report a map error</a></li>
        </ul>
      </div>
    </div>
    <p class="legal">© {year} {SITE.name}. Distances are for planning and curiosity, not for navigation or legal measurement.</p>
  </div>
</footer>
