    <path d="M40 300 L120 210 L170 262 L230 300Z M560 300 L640 196 L700 262 L740 300Z" fill="#e9eef2" />
    <path d="M96 236 C120 150 150 70 250 52 C360 32 520 30 590 70 C626 90 646 90 664 84" fill="none" stroke="#161b3d" stroke-width="9" stroke-linecap="round" />
    <path d="M96 236 C120 150 150 70 250 52 C360 32 520 30 590 70 C626 90 646 90 664 84" fill="none" stroke="#fff" stroke-width="2" stroke-dasharray="10 12" stroke-linecap="round" />
    <path d="M96 236 L664 84" stroke="#c4157a" stroke-width="4.5" stroke-linecap="round" />
    <g font-family="Archivo Variable, Archivo, system-ui, sans-serif" font-weight="700">
      <circle cx="96" cy="236" r="15" fill="#fff" stroke="#c4157a" stroke-width="4" /><text x="96" y="241" text-anchor="middle" font-size="14" fill="#161b3d">A</text>
      <circle cx="664" cy="84" r="15" fill="#fff" stroke="#c4157a" stroke-width="4" /><text x="664" y="89" text-anchor="middle" font-size="14" fill="#161b3d">B</text>
      <text x="330" y="196" font-size="16" fill="#c4157a" transform="rotate(-15 330 196)">Straight line, as the crow flies</text>
      <text x="306" y="28" font-size="16" fill="#161b3d">Road route around the lake</text>
    </g>
  </svg>
  <figcaption>The straight line is the floor. A road, a path or a flight route between the same two places can match it but never beat it.</figcaption>
</figure>
