---
// Straight line midpoints for city pairs, named by the nearest listed town. Computed at build time.
import { geodesic, intermediate, formatNumber, formatCoord } from '../../lib/geo';
import { nearestTown } from '../../lib/server/nearest';
type P = [string, number, number];
const pairs: [P, P][] = [
  [['New York', 40.7128, -74.006], ['Boston', 42.3601, -71.0589]],
  [['Los Angeles', 34.0522, -118.2437], ['San Francisco', 37.7749, -122.4194]],
  [['Chicago', 41.85, -87.65], ['Detroit', 42.3314, -83.0458]],
  [['Dallas', 32.7831, -96.8067], ['Houston', 29.7633, -95.3633]],
  [['Seattle', 47.6062, -122.3321], ['Portland', 45.5234, -122.6762]],
  [['Miami', 25.7743, -80.1937], ['Atlanta', 33.749, -84.388]],
  [['New York', 40.7128, -74.006], ['Chicago', 41.85, -87.65]],
  [['Chicago', 41.85, -87.65], ['Denver', 39.7392, -104.9903]],
  [['Los Angeles', 34.0522, -118.2437], ['New York', 40.7128, -74.006]],
  [['London', 51.5085, -0.1257], ['Manchester', 53.4809, -2.2374]],
  [['London', 51.5085, -0.1257], ['Paris', 48.8534, 2.3488]],
];
const MI = 1609.344;
const rows = pairs.map(([a, b]) => {
  const A = { lat: a[1], lon: a[2] }, B = { lat: b[1], lon: b[2] };
  const m = intermediate(A, B, 0.5);
  const n = nearestTown(m)!;
  return { a: a[0], b: b[0], half: geodesic(A, B).distance / 2 / MI, m, n, link: `/halfway-point-calculator/?p=${A.lat},${A.lon},${a[0]}&p=${B.lat},${B.lon},${b[0]}` };
});
---
<div class="table-scroll">
  <p class="table-title" aria-hidden="true">Straight line halfway points between city pairs</p>
  <table>
    <caption class="visually-hidden">Straight line halfway points between city pairs</caption>
    <thead><tr><th scope="col">Between</th><th scope="col" class="num">Each side</th><th scope="col">Midpoint</th><th scope="col">Nearest town to the midpoint</th></tr></thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <th scope="row"><a href={r.link}>{r.a} and {r.b}</a></th>
          <td class="num">{formatNumber(r.half, 0)} mi</td>
          <td class="num">{formatCoord(r.m, 2)}</td>
          <td>{r.n.label} <span class="muted">({formatNumber(r.n.d / MI, 0)} mi away)</span></td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="table-note">Towns of 5,000+ people in the US and UK from GeoNames. The halfway point along the road is usually somewhere else; open a pair in the calculator to see it.</p>
