---
// Infographic drawn at build time from the same maths the calculator uses.
import { geoMercator, geoPath, geoGraticule } from 'd3-geo';
import { land } from '../calculator/land';
import { C } from '../../data/routes';
import { haversine, rhumbDistance, geodesic, formatNumber, METRES_PER_MILE } from '../../lib/geo';

const a = C.newYork;
const b = C.london;
const W = 760;
const H = 400;
const projection = geoMercator()
  .center([-37, 50.5])
  .scale(430)
  .translate([W / 2, H / 2])
  .clipExtent([[0, 0], [W, H]]);
const path = geoPath(projection).digits(1);
const landD = path(land);
const gridD = path(geoGraticule().step([10, 10])());
const arcD = path({ type: 'LineString', coordinates: [[a.lon, a.lat], [b.lon, b.lat]] });
const pa = projection([a.lon, a.lat])!;
const pb = projection([b.lon, b.lat])!;

const great = haversine(a, b) / METRES_PER_MILE;
const rhumb = rhumbDistance(a, b) / METRES_PER_MILE;
const start = Math.round(geodesic(a, b).initialBearing);
const stats = [
  { value: `${formatNumber(great, 0)} mi`, label: 'Shortest path, the curved magenta line' },
  { value: `${formatNumber(rhumb, 0)} mi`, label: 'Constant compass heading, the dashed line' },
  { value: `${formatNumber(rhumb - great, 0)} mi`, label: 'Saved by following the curve' },
];
const alt = `Infographic from the as the crow flies distance calculator: on a flat map the shortest path from New York to London curves north and measures ${formatNumber(great, 0)} miles, while the line that looks straight measures ${formatNumber(rhumb, 0)} miles.`;
---
<figure class="course-map">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={alt}>
    <rect width={W} height={H} fill="#1a2050" />
    <path d={gridD} fill="none" stroke="#fff" stroke-opacity="0.08" />
    <path d={landD} fill="#2e3773" stroke="#5560a8" stroke-width="0.6" />
    <line x1={pa[0]} y1={pa[1]} x2={pb[0]} y2={pb[1]} stroke="#fff" stroke-width="2.5" stroke-dasharray="3 8" stroke-linecap="round" />
    <path d={arcD} fill="none" stroke="#ff5fb4" stroke-width="4" stroke-linecap="round" />
    <g font-family="Archivo Variable, Archivo, system-ui, sans-serif" font-weight="700">
      <circle cx={pa[0]} cy={pa[1]} r="12" fill="#fff" stroke="#c4157a" stroke-width="3.5" />
      <text x={pa[0]} y={pa[1] + 34} text-anchor="middle" font-size="15" fill="#fff">New York</text>
      <circle cx={pb[0]} cy={pb[1]} r="12" fill="#fff" stroke="#c4157a" stroke-width="3.5" />
      <text x={pb[0] - 8} y={pb[1] + 34} text-anchor="middle" font-size="15" fill="#fff">London</text>
      <text x={W / 2 - 20} y="118" text-anchor="middle" font-size="14" fill="#ff8fca">Leaves heading {start}°, northeast</text>
    </g>
  </svg>
  <dl>
    {stats.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
  </dl>
  <figcaption>New York to London on a Mercator map, both lines measured on a sphere. The map stretches the far north, so the shorter route is the one that looks longer.</figcaption>
</figure>
<style>
  .course-map svg { width: 100%; height: auto; display: block; border-radius: 14px 14px 0 0; }
  .course-map dl { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0; background: var(--night); color: #cfd3ef; border-radius: 0 0 14px 14px; }
  .course-map dl div { display: flex; flex-direction: column-reverse; padding: 1rem 1.2rem 1.15rem; border-top: 1px solid var(--night-rule); }
  .course-map dl div + div { border-left: 1px solid var(--night-rule); }
  .course-map dt { font-size: var(--step--1); line-height: 1.35; color: #aab0dc; }
  .course-map dd { margin: 0 0 0.2rem; font-size: clamp(1.4rem, 1rem + 2vw, 2.1rem); font-weight: 800; letter-spacing: -0.03em; color: #fff; font-variant-numeric: tabular-nums; line-height: 1.1; }
  @media (max-width: 560px) {
    .course-map dl { grid-template-columns: 1fr; }
    .course-map dl div + div { border-left: 0; }
  }
</style>
