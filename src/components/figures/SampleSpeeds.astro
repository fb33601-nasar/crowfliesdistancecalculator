---
// Average driving speed against trip length, from the captured route sample.
import { ADDRESS_SAMPLES, CITY_SAMPLES, SAMPLED_ON } from '../../data/route-samples';
import { formatNumber } from '../../lib/geo';
const MI = 1609.344;
const pts = [...ADDRESS_SAMPLES, ...CITY_SAMPLES].map((s) => ({ name: `${s.a.name} to ${s.b.name}`, mi: s.car[0] / MI, mph: s.car[0] / MI / (s.car[1] / 3600) }));
const W = 760, H = 330, L = 60, R = 24, T = 20, B = 50;
const x = (mi: number) => L + ((Math.log10(mi) - 0) / (Math.log10(600) - 0)) * (W - L - R);
const y = (mph: number) => H - B - (mph / 65) * (H - T - B);
const ticksX = [1, 2, 5, 10, 20, 50, 100, 200, 500];
const ticksY = [0, 10, 20, 30, 40, 50, 60];
---
<figure>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="ss-t ss-d" class="fig-light" style="background:#f4f7fb">
    <title id="ss-t">Average driving speed by trip length</title>
    <desc id="ss-d">{`A scatter chart of ${pts.length} sampled drives. City trips under 6 miles average 14 to 26 mph. Trips of 40 to 100 miles average 43 to 52 mph, and trips over 150 miles average 45 to 58 mph.`}</desc>
    {ticksY.map((t) => (
      <g>
        <line x1={L} x2={W - R} y1={y(t)} y2={y(t)} stroke="#dbe2ee" />
        <text x={L - 8} y={y(t) + 4} text-anchor="end" font-size="11" fill="#5b6385" font-family="Archivo Variable, Archivo, system-ui, sans-serif">{t}</text>
      </g>
    ))}
    {ticksX.map((t) => (
      <text x={x(t)} y={H - B + 18} text-anchor="middle" font-size="11" fill="#5b6385" font-family="Archivo Variable, Archivo, system-ui, sans-serif">{t}</text>
    ))}
    <text x={(L + W - R) / 2} y={H - 10} text-anchor="middle" font-size="12" font-weight="700" fill="#161b3d" font-family="Archivo Variable, Archivo, system-ui, sans-serif">Road distance, miles (log scale)</text>
    <text x="16" y={(T + H - B) / 2} text-anchor="middle" font-size="12" font-weight="700" fill="#161b3d" transform={`rotate(-90 16 ${(T + H - B) / 2})`} font-family="Archivo Variable, Archivo, system-ui, sans-serif">Average speed, mph</text>
    {pts.map((p) => (
      <circle cx={x(p.mi).toFixed(1)} cy={y(p.mph).toFixed(1)} r="7" fill="#c4157a" fill-opacity="0.85" stroke="#fff" stroke-width="2">
        <title>{`${p.name}: ${formatNumber(p.mi, 1)} mi at ${formatNumber(p.mph, 0)} mph`}</title>
      </circle>
    ))}
  </svg>
  <figcaption>{`Each dot is a real drive from our sample, timed in free-flowing traffic by an OpenStreetMap routing engine on ${new Date(SAMPLED_ON).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}. Short city trips are slow; longer trips average closer to highway speed.`}</figcaption>
</figure>
