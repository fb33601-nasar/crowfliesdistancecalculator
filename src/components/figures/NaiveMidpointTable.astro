---
// How far off a plain average of latitude and longitude lands from the true midpoint.
import { haversine, intermediate, geodesic, formatNumber } from '../../lib/geo';
type P = [string, number, number];
const pairs: [P, P][] = [
  [['New York', 40.7128, -74.006], ['Boston', 42.3601, -71.0589]],
  [['New York', 40.7128, -74.006], ['Chicago', 41.85, -87.65]],
  [['Chicago', 41.85, -87.65], ['Denver', 39.7392, -104.9903]],
  [['Los Angeles', 34.0522, -118.2437], ['New York', 40.7128, -74.006]],
  [['New York', 40.7128, -74.006], ['London', 51.5085, -0.1257]],
  [['Los Angeles', 34.0522, -118.2437], ['Tokyo', 35.6895, 139.6917]],
];
const MI = 1609.344;
const rows = pairs.map(([a, b]) => {
  const A = { lat: a[1], lon: a[2] }, B = { lat: b[1], lon: b[2] };
  const m = intermediate(A, B, 0.5);
  const naive = { lat: (A.lat + B.lat) / 2, lon: (A.lon + B.lon) / 2 };
  return { name: `${a[0]} and ${b[0]}`, dist: geodesic(A, B).distance / MI, off: haversine(m, naive) / MI };
});
const max = Math.log10(Math.max(...rows.map((r) => r.off)) + 1);
---
<div class="table-scroll nmt">
  <p class="table-title" aria-hidden="true">How far averaging the coordinates misses the true midpoint</p>
  <table>
    <caption class="visually-hidden">How far averaging the coordinates misses the true midpoint</caption>
    <thead><tr><th scope="col">Places</th><th scope="col" class="num">Distance apart</th><th scope="col" class="num">Average lands off by</th><th scope="col">Error, log scale</th></tr></thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <th scope="row">{r.name}</th>
          <td class="num">{formatNumber(r.dist, 0)} mi</td>
          <td class="num">{formatNumber(r.off, r.off < 10 ? 1 : 0)} mi</td>
          <td><span class="bar"><span style={`width:${Math.max((Math.log10(r.off + 1) / max) * 100, 2).toFixed(1)}%`}></span></span></td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<style>
  .nmt td:last-child { min-width: 9rem; }
  .bar { display: block; height: 0.7rem; background: color-mix(in srgb, var(--sea) 45%, #fff); border-radius: 4px; overflow: hidden; }
  .bar span { display: block; height: 100%; background: var(--course); border-radius: 0 4px 4px 0; }
</style>
