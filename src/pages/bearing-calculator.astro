---
import Base from '../layouts/Base.astro';
import H2 from '../components/H2.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedTools from '../components/RelatedTools.astro';
import BearingTool from '../components/calculator/BearingTool';
import Article, { frontmatter as fm } from '../content/bearing-calculator.mdx';
import { bearingFaqs } from '../content/bearing-faq';
import { SITE, abs } from '../lib/site';
import '../styles/calculator.css';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Bearing calculator', href: fm.slug },
];
const toc = [
  ['how-to-use-the-bearing-calculator', 'How to use the bearing calculator'],
  ['how-a-bearing-is-measured', 'How a bearing is measured'],
  ['initial-bearing-final-bearing-and-the-rhumb-line', 'Initial, final and rhumb line bearings'],
  ['true-bearing-vs-magnetic-bearing', 'True vs magnetic bearing'],
  ['bearing-formats-explained', 'Bearing formats'],
  ['the-bearing-formula', 'The bearing formula'],
  ['who-needs-a-bearing-calculator', 'Who needs it'],
  ['accuracy-and-limits', 'Accuracy and limits'],
  ['frequently-asked-questions', 'Frequently asked questions'],
];
const appSchema = {
  '@type': 'WebApplication',
  '@id': abs(`${fm.slug}#calculator`),
  name: 'Bearing Calculator',
  url: abs(fm.slug),
  description: fm.description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  isAccessibleForFree: true,
  inLanguage: SITE.lang,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: [
    'Initial and final great circle bearing between two points',
    'Back bearing and rhumb line bearing',
    'Magnetic bearing and declination from WMM2025',
    'Degrees-minutes-seconds, quadrant, compass point, mils and radians',
    'Destination point from a bearing and distance',
  ],
  publisher: { '@id': abs('/#organization') },
};
---
<Base title={fm.seo_title} description={fm.description} path={fm.slug} breadcrumbs={crumbs} faqs={bearingFaqs} schema={[appSchema]} datePublished={fm.datePublished} dateModified={fm.dateModified}>
  <div class="wrap hero">
    <Breadcrumbs items={crumbs} />
    <h1>{fm.title}</h1>
    <p class="lede">{fm.lede}</p>
  </div>

  <div class="wrap">
    <BearingTool client:load />
  </div>

  <div class="wrap article">
    <nav class="toc" aria-labelledby="toc-title">
      <h2 id="toc-title">On this page</h2>
      <ol>{toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
    </nav>

    <Article components={{ h2: H2 }} />

    <H2 id="frequently-asked-questions">Frequently asked questions</H2>
    <div class="faq">
      {bearingFaqs.map((f, i) => (
        <details open={i < 2}>
          <summary><h3>{f.q}</h3><span class="faq-toggle" aria-hidden="true"></span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <RelatedTools current={fm.slug} />

    <p class="updated">Last updated <time datetime={fm.dateModified}>November 14, 2026</time>. Magnetic declination from the World Magnetic Model 2025 (NOAA and BGS).</p>
  </div>
</Base>
