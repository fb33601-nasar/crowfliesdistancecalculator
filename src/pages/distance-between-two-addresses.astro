---
import Base from '../layouts/Base.astro';
import H2 from '../components/H2.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedTools from '../components/RelatedTools.astro';
import Calculator from '../components/calculator/Calculator';
import Article, { frontmatter as fm } from '../content/distance-between-two-addresses.mdx';
import { addressFaqs } from '../content/addresses-faq';
import { SITE, abs } from '../lib/site';
import '../styles/calculator.css';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Distance between two addresses', href: fm.slug },
];
const toc = [
  ['how-to-find-the-distance-between-two-addresses', 'How to find the distance between two addresses'],
  ['straight-line-driving-walking-or-cycling-which-distance-do-you-need', 'Which distance do you need?'],
  ['why-the-road-is-longer-than-the-straight-line', 'Why the road is longer than the straight line'],
  ['when-walking-is-shorter-than-driving', 'When walking is shorter than driving'],
  ['how-travel-time-is-estimated', 'How travel time is estimated'],
  ['mileage-between-two-addresses-for-expenses-and-tax', 'Mileage for expenses and tax'],
  ['getting-an-accurate-result-from-an-address', 'Getting an accurate result'],
  ['how-to-find-the-distance-between-two-addresses-on-google-maps', 'Using Google Maps'],
  ['limits-of-an-address-to-address-distance', 'Limits'],
  ['frequently-asked-questions', 'Frequently asked questions'],
];
const appSchema = {
  '@type': 'WebApplication',
  '@id': abs(`${fm.slug}#calculator`),
  name: 'Distance Between Two Addresses Calculator',
  url: abs(fm.slug),
  description: fm.description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  isAccessibleForFree: true,
  inLanguage: SITE.lang,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: [
    'Driving, walking and cycling distance between two addresses',
    'Straight line distance',
    'Travel time for each route',
    'Detour index compared with the straight line',
    'Mileage value at IRS and HMRC rates',
    'Shareable result link',
  ],
  publisher: { '@id': abs('/#organization') },
};
---
<Base
  title={fm.seo_title}
  description={fm.description}
  path={fm.slug}
  breadcrumbs={crumbs}
  faqs={addressFaqs}
  schema={[appSchema]}
  datePublished={fm.datePublished}
  dateModified={fm.dateModified}
>
  <div class="wrap hero">
    <Breadcrumbs items={crumbs} />
    <h1>{fm.title}</h1>
    <p class="lede">{fm.lede}</p>
  </div>

  <div class="wrap">
    <Calculator client:load variant="travel" />
  </div>

  <div class="wrap article">
    <nav class="toc" aria-labelledby="toc-title">
      <h2 id="toc-title">On this page</h2>
      <ol>{toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
    </nav>

    <Article components={{ h2: H2 }} />

    <H2 id="frequently-asked-questions">Frequently asked questions</H2>
    <div class="faq">
      {addressFaqs.map((f, i) => (
        <details open={i < 2}>
          <summary><h3>{f.q}</h3><span class="faq-toggle" aria-hidden="true"></span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <RelatedTools current={fm.slug} />

    <p class="updated">Last updated <time datetime={fm.dateModified}>November 14, 2026</time>. Routes and times from OpenStreetMap data via the FOSSGIS routing server.</p>
  </div>
</Base>
