---
import Base from '../layouts/Base.astro';
import H2 from '../components/H2.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedTools from '../components/RelatedTools.astro';
import DriveTimeTool from '../components/calculator/DriveTimeTool';
import Article, { frontmatter as fm } from '../content/drive-time-map.mdx';
import { driveTimeFaqs } from '../content/drivetime-faq';
import { SITE, abs } from '../lib/site';
import '../styles/calculator.css';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Drive time map', href: fm.slug },
];
const toc = [
  ['how-to-make-a-drive-time-map', 'How to make a drive time map'],
  ['drive-time-map-vs-radius-map', 'Drive time vs radius'],
  ['how-far-can-you-drive-in-15-30-or-60-minutes', 'How far in 15, 30 or 60 minutes'],
  ['what-people-use-drive-time-maps-for', 'Uses'],
  ['how-the-drive-time-areas-are-worked-out', 'How it works'],
  ['limits-of-a-drive-time-map', 'Limits'],
  ['frequently-asked-questions', 'Frequently asked questions'],
];
const appSchema = {
  '@type': 'WebApplication',
  '@id': abs(`${fm.slug}#calculator`),
  name: 'Drive Time Map',
  url: abs(fm.slug),
  description: fm.description,
  applicationCategory: 'TravelApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  isAccessibleForFree: true,
  inLanguage: SITE.lang,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: [
    'Drive, cycle and walk time areas from any start',
    'Up to four time bands up to two hours',
    'Area and farthest reach of each band',
    'Towns inside each band',
    'Shareable map link',
  ],
  publisher: { '@id': abs('/#organization') },
};
---
<Base title={fm.seo_title} description={fm.description} path={fm.slug} breadcrumbs={crumbs} faqs={driveTimeFaqs} schema={[appSchema]} datePublished={fm.datePublished} dateModified={fm.dateModified}>
  <div class="wrap hero">
    <Breadcrumbs items={crumbs} />
    <h1>{fm.title}</h1>
    <p class="lede">{fm.lede}</p>
  </div>

  <div class="wrap">
    <DriveTimeTool client:load />
  </div>

  <div class="wrap article">
    <nav class="toc" aria-labelledby="toc-title">
      <h2 id="toc-title">On this page</h2>
      <ol>{toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
    </nav>

    <Article components={{ h2: H2 }} />

    <H2 id="frequently-asked-questions">Frequently asked questions</H2>
    <div class="faq">
      {driveTimeFaqs.map((f, i) => (
        <details open={i < 2}>
          <summary><h3>{f.q}</h3><span class="faq-toggle" aria-hidden="true"></span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <RelatedTools current={fm.slug} />

    <p class="updated">Last updated <time datetime={fm.dateModified}>November 14, 2026</time>. Routing by Valhalla on OpenStreetMap data via the FOSSGIS server.</p>
  </div>
</Base>
