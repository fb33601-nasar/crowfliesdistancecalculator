---
import Base from '../layouts/Base.astro';
import H2 from '../components/H2.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedTools from '../components/RelatedTools.astro';
import HalfwayTool from '../components/calculator/HalfwayTool';
import Article, { frontmatter as fm } from '../content/halfway-point-calculator.mdx';
import { halfwayFaqs } from '../content/halfway-faq';
import { SITE, abs } from '../lib/site';
import '../styles/calculator.css';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Halfway point calculator', href: fm.slug },
];
const toc = [
  ['how-to-find-the-halfway-point-between-two-places', 'How to find the halfway point'],
  ['three-kinds-of-halfway-point', 'Three kinds of halfway point'],
  ['halfway-points-between-popular-city-pairs', 'Popular city pairs'],
  ['why-you-cant-just-average-the-coordinates', 'Why averaging coordinates fails'],
  ['finding-the-midpoint-of-three-or-more-places', 'Three or more places'],
  ['choosing-a-fair-place-to-meet-halfway', 'Choosing a fair place to meet'],
  ['halfway-along-a-road-trip', 'Halfway on a road trip'],
  ['finding-the-halfway-point-on-google-maps', 'On Google Maps'],
  ['how-the-halfway-point-is-calculated', 'How it is calculated'],
  ['limits', 'Limits'],
  ['frequently-asked-questions', 'Frequently asked questions'],
];
const appSchema = {
  '@type': 'WebApplication',
  '@id': abs(`${fm.slug}#calculator`),
  name: 'Halfway Point Calculator',
  url: abs(fm.slug),
  description: fm.description,
  applicationCategory: 'TravelApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  isAccessibleForFree: true,
  inLanguage: SITE.lang,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: [
    'Straight line midpoint between two places',
    'Halfway point along the driving, cycling or walking route',
    'Halfway point by travel time',
    'Towns near the halfway point',
    'Geographic midpoint of up to six places',
    'Shareable result link',
  ],
  publisher: { '@id': abs('/#organization') },
};
---
<Base title={fm.seo_title} description={fm.description} path={fm.slug} breadcrumbs={crumbs} faqs={halfwayFaqs} schema={[appSchema]} datePublished={fm.datePublished} dateModified={fm.dateModified}>
  <div class="wrap hero">
    <Breadcrumbs items={crumbs} />
    <h1>{fm.title}</h1>
    <p class="lede">{fm.lede}</p>
  </div>

  <div class="wrap">
    <HalfwayTool client:load />
  </div>

  <div class="wrap article">
    <nav class="toc" aria-labelledby="toc-title">
      <h2 id="toc-title">On this page</h2>
      <ol>{toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
    </nav>

    <Article components={{ h2: H2 }} />

    <H2 id="frequently-asked-questions">Frequently asked questions</H2>
    <div class="faq">
      {halfwayFaqs.map((f, i) => (
        <details open={i < 2}>
          <summary><h3>{f.q}</h3><span class="faq-toggle" aria-hidden="true"></span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <RelatedTools current={fm.slug} />

    <p class="updated">Last updated <time datetime={fm.dateModified}>November 14, 2026</time>. Routes from OpenStreetMap via the FOSSGIS routing server. Town list from GeoNames.</p>
  </div>
</Base>
